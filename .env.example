# Dosije: copy to .env (optional).
# With NO key the app still runs in "scripted" mode: the real Mozaik runtime, loops,
# tools, events, shared state and interception, with a deterministic InferenceRunner
# instead of an LLM (Mozaik's official custom-runner extension point).

# ── LLM (recommended: OpenAI) ────────────────────────────────────────────────
OPENAI_API_KEY=
# Worker agents (Kadrovik, Nabavke, Firme, ...) and the Editor (Urednik)
DOSIJE_MODEL=gpt-5.4-mini
DOSIJE_EDITOR_MODEL=gpt-5.4
# none | low | medium | high
DOSIJE_REASONING=low
# Max parallel LLM calls (protects against 429 rate limits)
LLM_CONCURRENCY=8

# Other providers also work (auto-detected if OPENAI_API_KEY is empty):
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# ── Web search (optional; free RSS + Google News RSS + GDELT are used without keys) ──
# Serper.dev (Google results, 2,500 free queries, no card)
SERPER_API_KEY=
# Brave Search API ($5 free credit/month)
BRAVE_API_KEY=

# ── Data ─────────────────────────────────────────────────────────────────────
# auto = cache first, then live public sources | cache = cache only | live = always fetch
DATA_MODE=auto

# Agents never ask the user for data (owners come from CompanyWall; a missing fact is written as missing).
# DOSIJE_ASK_HUMAN=1 brings back the questions to the journalist (inbox).
# DOSIJE_ASK_HUMAN=
# Sensitive signals go in on their sources (official / confirmed / unconfirmed); DOSIJE_APPROVALS=1 makes them wait for approval.
# DOSIJE_APPROVALS=
# DOSIJE_COMPANYWALL=0 turns the CompanyWall owner lookup off.

# Searches are one-time: when the last open page is closed, the case or map is stopped and dropped after this many ms.
# DOSIJE_ABANDON_MS=60000

# Scripted-mode pacing (1 = realistic, 0.3 = fast)
DEMO_SPEED=1

PORT=3000
